# Supabase project (database + auth + storage)
# Create a project at https://supabase.com and copy these from Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only: used for service-role operations (admin actions, storage uploads)
# NEVER expose this to the browser (no VITE_ prefix)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_ANON_KEY=YOUR-ANON-KEY

PORT=8787
# Extra CORS origins, comma-separated. Production (parcelvaultlogistics.com),
# localhost/127.0.0.1 (any port) and *.vercel.app previews are already allowed.
CLIENT_ORIGIN=http://localhost:5173

# Public API base URL used by the frontend. Local development defaults to /api.
VITE_API_BASE_URL=/api

# Resend transactional email (SERVER ONLY — never add a VITE_ prefix).
# Create a key at https://resend.com/api-keys and verify the sending domain.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=support@parcelvaultlogistics.com
RESEND_FROM_NAME=ParcelVault Logistics
SUPPORT_EMAIL=support@parcelvaultlogistics.com
PUBLIC_SITE_URL=https://www.parcelvaultlogistics.com

# Crypto / wire wallet (shown on payment page)
USDT_TRC20_ADDRESS=TXMjZ7MrfUMTFMQ96AwRTJTdsR3NmaL41u
ACH_ACCOUNT_HOLDER=ParcelVault Logistics
ACH_BANK=Lead Bank
ACH_ACCOUNT_NUMBER=214144811917
ACH_ROUTING_NUMBER=101019644
ACH_ACCOUNT_TYPE=Personal Checking
ACH_BANK_ADDRESS=1801 Main Street, Kansas City, MO 64108, United States
